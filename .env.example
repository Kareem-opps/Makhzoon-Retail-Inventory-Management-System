# Copy this file to .env and replace placeholders with credentials for the
# existing PostgreSQL database. Never commit the resulting .env file.
DATABASE_URL=postgresql://POSTGRES_USER:POSTGRES_PASSWORD@localhost:5432/inventory_db
SECRET_KEY=replace-with-a-long-random-value
BUSINESS_TIMEZONE=Africa/Cairo

# Local session policy. Enable secure cookies when the application is served
# over HTTPS; keep false only for local HTTP development.
SESSION_COOKIE_SECURE=false
LOGIN_MAX_ATTEMPTS=5
LOGIN_ATTEMPT_WINDOW_MINUTES=15
PASSWORD_RESET_MINUTES=60
PASSWORD_MIN_LENGTH=12
# Trusted absolute origin used to build password-reset links.
PUBLIC_BASE_URL=

# Authentication email is opt-in. Password reset tests use a local test sender
# and must not send real email.
ENABLE_AUTH_EMAIL=false

# Scheduled report email is also opt-in.
ENABLE_REPORT_EMAIL=false
REPORT_EMAIL_TO=
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_USE_TLS=true

# Dedicated disposable PostgreSQL database used only by integration tests.
# Never point this at the working application database.
TEST_DATABASE_URL=
